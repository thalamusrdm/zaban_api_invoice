      "main": [
        [{ "node": "תשובה: כבר קיימת", "type": "main", "index": 0 }],
        [{ "node": "יצירת חשבונית בפריוריטי", "type": "main", "index": 0 }]
      ]
    },
    "יצירת חשבונית בפריוריטי": {
      "main": [
        [{ "node": "תשובה: הצלחה", "type": "main", "index": 0 }],
