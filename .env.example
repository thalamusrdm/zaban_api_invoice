# העתיקו קובץ זה ל-.env ומלאו את הסיסמה. .env לא נכנס ל-git.
PRIORITY_BASE_URL=https://iis.zaban-bechor.co.il/odata/Priority/tabula15.ini
# zaban = ייצור ("צבאן בכור תכשיטים בע"מ"), zabant = טסט (04/06/26), zabcopy = טסט ישן (2020)
PRIORITY_COMPANY=zaban
PRIORITY_USER=API
PRIORITY_PASSWORD=********
PORT=18473

# Optional original-PDF email transport. Configure on the server, never in chat.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_FROM=digital@zaban-bechor.co.il
SMTP_USER=digital@zaban-bechor.co.il
# Microsoft 365: register a dedicated app and authorize SMTP.Send + offline_access.
# Existing Priority OAuth credentials cannot be reused by this app.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
SMTP_OAUTH_SCOPE=https://outlook.office.com/SMTP.Send offline_access
# For SMTP providers that support password authentication instead of OAuth:
SMTP_PASSWORD=
